[Version]

Signature   = "$Windows NT$"

Class       = MEDIA

Provider    = %ProviderName%

ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}

DriverVer   = 09/30/2026, 0.1.0.0

CatalogFile = audiowire.cat

PnpLockDown = 1

[SourceDisksNames]

222="AUDIOWIRE Driver Disk","",222

[SourceDisksFiles]

audiowire.sys=222

[SignatureAttributes]

audiowire.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]

DRMLevel=1300

[SignatureAttributes.PETrust]

PETrust=true

[Manufacturer]

%MfgName%=AUDIOWIRE,NT$ARCH$.10.0...19041

[AUDIOWIRE.NT$ARCH$.10.0...19041]

%AUDIOWIRE_SA.DeviceDesc%=AUDIOWIRE_SA, ROOT\audiowire

[DestinationDirs]

AUDIOWIRE_SA.CopyList=13 ; 13=Package's DriverStore directory

;======================================================

; AUDIOWIRE_SA

;======================================================

[AUDIOWIRE_SA.CopyList]

audiowire.sys

[AUDIOWIRE_SA.AddReg]

HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"

HKR,,Driver,,audiowire.sys

;

; For demo only, please review these power management settings for your architecture. 

;

HKR,PowerSettings,SingleComponentMultiFxStates,3,1,0,0,0  ; Turn on multi Fx support.

HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0          ; 3 seconds for idle power management when on battery

HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0           ; 3 seconds for idle power management when on AC power

HKR,PowerSettings,IdlePowerState,3,3,0,0,0                ; go to D3 for idle power management

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%AUDIOWIRE_SA.DeviceDesc%

HKR,Drivers\mixer\wdmaud.drv,Description,,%AUDIOWIRE_SA.DeviceDesc%

;======================================================

; capture interfaces: mic array (internal: front)

;======================================================

[AUDIOWIRE.I.WaveMicArray1]

AddReg=AUDIOWIRE.I.WaveMicArray1.AddReg

[AUDIOWIRE.I.WaveMicArray1.AddReg]

HKR,,CLSID,,%Proxy.CLSID%

HKR,,FriendlyName,,%AUDIOWIRE.WaveMicArray1.szPname%

[AUDIOWIRE.I.TopologyMicArray1]

AddReg=AUDIOWIRE.I.TopologyMicArray1.AddReg

[AUDIOWIRE.I.TopologyMicArray1.AddReg]

HKR,,CLSID,,%Proxy.CLSID%

HKR,,FriendlyName,,%AUDIOWIRE.TopologyMicArray1.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

; The following lines opt-in to pull mode.

HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================

; render interfaces: speaker (internal)

;======================================================

[AUDIOWIRE.I.WaveSpeaker]

AddReg=AUDIOWIRE.I.WaveSpeaker.AddReg

[AUDIOWIRE.I.WaveSpeaker.AddReg]

HKR,,CLSID,,%Proxy.CLSID%

HKR,,FriendlyName,,%AUDIOWIRE.WaveSpeaker.szPname%

[AUDIOWIRE.I.TopologySpeaker]

AddReg=AUDIOWIRE.I.TopologySpeaker.AddReg

[AUDIOWIRE.I.TopologySpeaker.AddReg]

HKR,,CLSID,,%Proxy.CLSID%

HKR,,FriendlyName,,%AUDIOWIRE.TopologySpeaker.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

; The following lines opt-in to pull mode.

HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================

; AUDIOWIRE_SA

;======================================================

[AUDIOWIRE_SA.NT]

Include=ks.inf,wdmaudio.inf

Needs=KS.Registration, WDMAUDIO.Registration

CopyFiles=AUDIOWIRE_SA.CopyList

AddReg=AUDIOWIRE_SA.AddReg

[AUDIOWIRE_SA.NT.Interfaces]

;

; Interfaces for speaker (internal) render endpoint.

;

AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, AUDIOWIRE.I.WaveSpeaker

AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, AUDIOWIRE.I.WaveSpeaker

AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, AUDIOWIRE.I.WaveSpeaker

AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, AUDIOWIRE.I.TopologySpeaker

AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, AUDIOWIRE.I.TopologySpeaker

;

; Interfaces for microphone array 1 (internal: front) capture endpoint.

;

AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_WaveMicArray1%, AUDIOWIRE.I.WaveMicArray1

AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveMicArray1%, AUDIOWIRE.I.WaveMicArray1

AddInterface=%KSCATEGORY_CAPTURE%,  %KSNAME_WaveMicArray1%, AUDIOWIRE.I.WaveMicArray1

AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicArray1%, AUDIOWIRE.I.TopologyMicArray1

AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicArray1%, AUDIOWIRE.I.TopologyMicArray1

[AUDIOWIRE_SA.NT.Services]

AddService=audiowire,0x00000002,audiowire_Service_Inst

[audiowire_Service_Inst]

DisplayName=%audiowire.SvcDesc%

ServiceType=1

StartType=3

ErrorControl=1

ServiceBinary=%13%\audiowire.sys

[AUDIOWIRE_SA.NT.HW]

AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]

; FILE_DEVICE_SOUND

HKR,,DeviceType,0x10001,0x0000001D

; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX

HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

;======================================================

; WDF

;======================================================

[AUDIOWIRE_SA.NT.Wdf]

KmdfService = audiowire, AUDIOWIRE_SA_WdfSect

[AUDIOWIRE_SA_WdfSect]

KmdfLibraryVersion = $KMDFVERSION$

;======================================================

; COMMON

;======================================================

[Strings]

;Non-localizable

KSNAME_WaveSpeaker="WaveSpeaker"

KSNAME_TopologySpeaker="TopologySpeaker"

KSNAME_WaveMicArray1="WaveMicArray1"

KSNAME_TopologyMicArray1="TopologyMicArray1"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"

KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"

KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"

KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"

KSCATEGORY_REALTIME ="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"

KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

KSNODETYPE_ANY   = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"

PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

;Localizable

ProviderName = "AudioWire contributors"

MfgName      = "AudioWire contributors"

MsCopyRight  = "AudioWire contributors"

AUDIOWIRE_SA.DeviceDesc="AudioWire Speaker"

audiowire.SvcDesc="AudioWire Speaker"

;; friendly names

AUDIOWIRE.WaveSpeaker.szPname="AudioWire Speaker"

AUDIOWIRE.TopologySpeaker.szPname="AudioWire Speaker"

AUDIOWIRE.WaveMicArray1.szPname="AudioWire Microphone"

AUDIOWIRE.TopologyMicArray1.szPname="AudioWire Microphone"

MicArray1CustomName= "AudioWire Microphone"

