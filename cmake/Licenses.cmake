# Preserve the upstream texts in every binary package.
set(aw_licenses "${CMAKE_BINARY_DIR}/licenses")
file(MAKE_DIRECTORY "${aw_licenses}")
function(aw_license name path)
    configure_file("${path}" "${aw_licenses}/${name}" COPYONLY)
endfunction()
function(aw_header_notice name path)
    file(READ "${path}" source)
    string(FIND "${source}" "*/" end)
    if(end LESS 0)
        message(FATAL_ERROR "No licence header in ${path}")
    endif()
    math(EXPR length "${end}+2")
    string(SUBSTRING "${source}" 0 ${length} notice)
    file(WRITE "${aw_licenses}/${name}" "${notice}\n")
endfunction()
aw_license("JUCE-LICENSE.md" "${JUCE_SOURCE_DIR}/LICENSE.md")
aw_license("AOO-LICENSE.txt" "${aoo_SOURCE_DIR}/LICENSE")
aw_license("oscpack-LICENSE.txt" "${aoo_SOURCE_DIR}/deps/oscpack/LICENSE")
aw_header_notice("md5-NOTICE.txt" "${aoo_SOURCE_DIR}/deps/md5/md5.c")
aw_license("Opus-COPYING.txt" "${opus_SOURCE_DIR}/COPYING")
aw_license("libsodium-LICENSE.txt" "${libsodium_SOURCE_DIR}/LICENSE")
aw_header_notice("QR-generator-LICENSE.txt" "${qrcodegen_SOURCE_DIR}/cpp/qrcodegen.hpp")
aw_license("libpng-LICENSE.txt" "${JUCE_SOURCE_DIR}/modules/juce_graphics/image_formats/pnglib/LICENSE")
aw_license("libjpeg-README.txt" "${JUCE_SOURCE_DIR}/modules/juce_graphics/image_formats/jpglib/README")
aw_license("libjpeg-JUCE-changes.txt" "${JUCE_SOURCE_DIR}/modules/juce_graphics/image_formats/jpglib/changes to libjpeg for JUCE.txt")
aw_header_notice("zlib-NOTICE.txt" "${JUCE_SOURCE_DIR}/modules/juce_core/zip/zlib/zlib.h")
foreach(module juce_core juce_events juce_graphics juce_gui_basics juce_gui_extra juce_data_structures juce_audio_basics juce_audio_devices)
    aw_header_notice("${module}-NOTICE.txt" "${JUCE_SOURCE_DIR}/modules/${module}/${module}.h")
endforeach()
if(WIN32)
    aw_license("mdns-LICENSE.txt" "${mdns_SOURCE_DIR}/LICENSE")
endif()
aw_license("Driver-reference-LICENSE.txt" "${PROJECT_SOURCE_DIR}/driver/vendor/LICENSE")
aw_license("Driver-NOTICES.md" "${PROJECT_SOURCE_DIR}/driver/vendor/THIRD_PARTY_NOTICES.md")
install(DIRECTORY "${aw_licenses}/" DESTINATION licenses)

if(MINGW)
    get_filename_component(aw_compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
    get_filename_component(aw_compiler_root "${aw_compiler_bin}" DIRECTORY)
    if(EXISTS "${aw_compiler_root}/COPYING.MinGW-w64-runtime.txt")
        aw_license("MinGW-w64-runtime.txt" "${aw_compiler_root}/COPYING.MinGW-w64-runtime.txt")
    endif()
endif()
